{
  "name": "jungle-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "migrate:up": "bun run src/infrastructure/persistence/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/persistence/migrate.ts down",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 60000 test/integration",
    "test:concurrency": "bun test --timeout 120000 test/concurrency",
    "test:all": "bun test --timeout 120000 test",
    "test:load": "bun run test/load/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1161.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "jose": "6.2.14",
    "pg": "8.16.3",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.2.21",
    "@types/express": "5.0.3",
    "@types/pg": "8.15.5",
    "typescript": "5.8.3"
  }
}
